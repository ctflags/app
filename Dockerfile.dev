FROM node:22.15-alpine

# Set development environment
ENV NODE_ENV=development

WORKDIR /app

# Copy package files first for better caching
COPY package*.json ./

# Install all dependencies (including dev dependencies)
RUN npm ci

# Copy the rest of the source files
COPY . .

# Create shared directory for file uploads
RUN mkdir -p /tmp/shared

# Create a non-root user but don't switch to it yet (for better file permissions with bind mounts)
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodeuser -u 1001 -G nodejs

# Change ownership of the app directory and shared directory
RUN chown -R nodeuser:nodejs /app && \
    chown -R nodeuser:nodejs /tmp/shared

# Switch to non-root user
USER nodeuser

# Expose the port
EXPOSE 3000

# Use Node.js built-in watch mode for development
CMD ["node", "--watch", "app.js"]
