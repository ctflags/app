challenges:
  - name: "Challenge 1"
    description: "Find the flag in ctf-ch1 namespace"
    flag: "pod_logs_are_essential"
    points: 50
    hint: "Did you wait enough?"
  - name: "Challenge 2"
    description: "Find the flag in ctf-ch2 namespace"
    flag: "dont_put_config_in_code"
    points: 50
    hint: "Is the config right?"
  - name: "Challenge 3"
    description: "Find the flag in ctf-ch3 namespace"
    flag: "keep_your_secrets_safe"
    points: 100
    hint: "Keep it secret"
  - name: "Challenge 4"
    description: "Find the flag in ctf-ch4 namespace"
    flag: "some_services_are_internal"
    points: 250
    hint: "Did you try accessing the frontend?"
  - name: "Challenge 5"
    description: "Find the flag in ctf-ch5 namespace"
    flag: "secure_your_filesystem"
    points: 250
    hint: "what about / ?"
  - name: "Challenge 6"
    description: "Find the flag in ctf-ch6 namespace"
    flag: "save_info_in_the_resource"
    points: 250
    hint: "One on each node"
  - name: "Challenge 7"
    description: "Find the flag in ctf-ch7 namespace"
    flag: "this_pv_is_where_the_truth_is"
    points: 250
    hint: "What is this volume?"
  - name: "Challenge 8"
    description: "Find the flag in ctf-ch8 namespace"
    flag: "elevate_your_privileges"
    points: 250
    hint: "Could you gain more rights?"

