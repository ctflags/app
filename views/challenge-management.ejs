<!DOCTYPE html>
<html>
<%- include('partials/admin-head', { title: 'CTF Challenge Management' }) %>
<body>
    <div class="container">
        <div class="header">
            <h1>🎯 Challenge Management</h1>
            <div class="nav-buttons">
                <button onclick="navigateToPage('/organizer/admin')" class="nav-btn">← Back to Admin Panel</button>
                <button onclick="showCreateForm()" class="nav-btn primary">+ Add New Challenge</button>
                <button onclick="showUploadForm()" class="nav-btn secondary">📤 Upload YAML</button>
                <button onclick="deleteAllChallenges()" class="nav-btn danger">🗑️ Delete All Challenges</button>
            </div>
        </div>

        <!-- Create/Edit Form -->
        <div id="challengeForm" class="form-container hidden">
            <h3 id="formTitle">Create New Challenge</h3>
            <form id="challengeFormElement">
                <input type="hidden" id="challengeId" name="id">
                <div class="form-group">
                    <label for="name">Challenge Name</label>
                    <input type="text" id="name" name="name" required>
                </div>
                <div class="form-group">
                    <label for="description">Description</label>
                    <textarea id="description" name="description" required></textarea>
                </div>
                <div class="form-group">
                    <label for="flag">Flag</label>
                    <input type="text" id="flag" name="flag" placeholder="CTF{example_flag}" required>
                </div>
                <div class="form-group">
                    <label for="points">Points</label>
                    <input type="number" id="points" name="points" min="1" value="100" required>
                </div>
                <div class="form-group">
                    <label for="hint">Hint (optional)</label>
                    <textarea id="hint" name="hint" placeholder="Optional hint for participants"></textarea>
                </div>
                <button type="submit" class="form-btn" id="submitBtn">Create Challenge</button>
                <button type="button" class="form-btn cancel" onclick="hideForm()">Cancel</button>
            </form>
        </div>

        <!-- YAML Upload Form -->
        <div id="uploadForm" class="form-container hidden">
            <h3>Upload Challenges from YAML</h3>
            <p style="color: #ccc; margin-bottom: 20px;">
                Upload a YAML file with challenges in the following format:<br>
                <code style="background: #1a1a1a; padding: 10px; display: block; margin: 10px 0; border-radius: 4px;">
challenges:<br>
&nbsp;&nbsp;- name: "Web Challenge 1"<br>
&nbsp;&nbsp;&nbsp;&nbsp;description: "Find the hidden flag"<br>
&nbsp;&nbsp;&nbsp;&nbsp;flag: "flag{hidden_secret}"<br>
&nbsp;&nbsp;&nbsp;&nbsp;points: 100<br>
&nbsp;&nbsp;&nbsp;&nbsp;hint: "Check the source code"<br>
&nbsp;&nbsp;- name: "Crypto Challenge 1"<br>
&nbsp;&nbsp;&nbsp;&nbsp;description: "Decode this message"<br>
&nbsp;&nbsp;&nbsp;&nbsp;flag: "flag{crypto_master}"<br>
&nbsp;&nbsp;&nbsp;&nbsp;points: 150
                </code>
            </p>
            <form id="uploadFormElement" enctype="multipart/form-data">
                <div class="form-group">
                    <label for="yamlFile">YAML File</label>
                    <input type="file" id="yamlFile" name="yamlFile" accept=".yaml,.yml,.txt" required>
                </div>
                <button type="submit" class="form-btn">Upload Challenges</button>
                <button type="button" class="form-btn cancel" onclick="hideUploadForm()">Cancel</button>
            </form>
        </div>

        <!-- Challenges Table -->
        <div class="data-table">
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Description</th>
                        <th>Flag</th>
                        <th>Points</th>
                        <th>Hint</th>
                        <th>Created</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% challenges.forEach(function(challenge) { %>
                      <tr>
                        <td><%= challenge.id %></td>
                        <td><strong><%= challenge.name %></strong></td>
                        <td><%= challenge.description.length > 50 ? challenge.description.substring(0, 50) + '...' : challenge.description %></td>
                        <td><span class="flag"><%= challenge.flag %></span></td>
                        <td><span class="points"><%= challenge.points %></span></td>
                        <td><%= (challenge.hint && challenge.hint.length > 30) ? challenge.hint.substring(0, 30) + '...' : (challenge.hint || '-') %></td>
                        <td><%= new Date(challenge.created_at).toLocaleDateString() %></td>
                        <td>
                            <button class="action-btn edit-btn" onclick="editChallenge(<%= challenge.id %>, '<%= challenge.name.replace(/'/g, "\\'") %>', '<%= challenge.description.replace(/'/g, "\\'") %>', '<%= challenge.flag.replace(/'/g, "\\'") %>', <%= challenge.points %>, '<%= (challenge.hint || '').replace(/'/g, "\\'") %>')">Edit</button>
                            <button class="action-btn delete-btn" onclick="deleteChallenge(<%= challenge.id %>, '<%= challenge.name.replace(/'/g, "\\'") %>')">Delete</button>
                        </td>
                      </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </div>

    <%- include('partials/popup-confirm') %>
    <%- include('partials/popup-text-confirm') %>
    <%- include('partials/popup-result') %>

    <%- include('partials/admin-scripts') %>
    
    <script>
        // Handle authentication
        <% if (typeof needsAuth !== 'undefined' && needsAuth) { %>
        // Page loaded without token, check localStorage and redirect if needed
        (function() {
            const token = localStorage.getItem('organizerToken');
            if (token) {
                window.location.href = `${window.location.pathname}?token=${token}`;
            } else {
                window.location.href = '/organizer';
            }
        })();
        <% } else { %>
        // Clean up URL if it contains token parameter
        if (window.location.search.includes('token=')) {
            const url = new URL(window.location);
            url.search = '';
            window.history.replaceState({}, document.title, url.toString());
        }
        <% } %>
    </script>
    
    <script>
        let isEditing = false;

        function showCreateForm() {
            adminUtils.toggleForm('challengeForm', 'formTitle', 'submitBtn', false, 
                'Create New Challenge', 'Edit Challenge', 'Create Challenge', 'Update Challenge');
            document.getElementById('challengeFormElement').reset();
            document.getElementById('challengeId').value = '';
            isEditing = false;
        }

        function editChallenge(id, name, description, flag, points, hint) {
            adminUtils.toggleForm('challengeForm', 'formTitle', 'submitBtn', true, 
                'Create New Challenge', 'Edit Challenge', 'Create Challenge', 'Update Challenge');
            document.getElementById('challengeId').value = id;
            document.getElementById('name').value = name;
            document.getElementById('description').value = description;
            document.getElementById('flag').value = flag;
            document.getElementById('points').value = points;
            document.getElementById('hint').value = hint || '';
            isEditing = true;
        }

        function hideForm() {
            adminUtils.hideForm('challengeForm', 'challengeFormElement');
            isEditing = false;
        }

        function deleteChallenge(id, name) {
            adminUtils.deleteItem('/api/challenges', id, name, 'Challenge');
        }

        function deleteAllChallenges() {
            window.popupManager.showConfirmation(
                'Delete All Challenges',
                'Are you sure you want to delete ALL challenges and their related records (submissions, hint views)?<br><br><strong>This action cannot be undone!</strong>',
                async () => {
                    try {
                        const token = localStorage.getItem('organizerToken');
                        const response = await fetch('/api/challenges/delete-all', {
                            method: 'DELETE',
                            headers: {
                                'Authorization': `Bearer ${token}`,
                                'Content-Type': 'application/json'
                            }
                        });

                        const result = await response.json();
                        
                        if (response.ok) {
                            showResult('success', 'Success', result.message, true);
                        } else {
                            showResult('error', 'Error', result.error || 'Failed to delete challenges');
                        }
                    } catch (error) {
                        console.error('Error deleting all challenges:', error);
                        showResult('error', 'Error', 'Connection error while deleting challenges');
                    }
                }
            );
        }

        function showUploadForm() {
            document.getElementById('uploadForm').classList.remove('hidden');
            document.getElementById('challengeForm').classList.add('hidden');
        }

        function hideUploadForm() {
            document.getElementById('uploadForm').classList.add('hidden');
            document.getElementById('uploadFormElement').reset();
        }

        function navigateToPage(path) {
            const token = localStorage.getItem('organizerToken');
            if (!token) {
                window.location.href = '/organizer';
                return;
            }
            // Include token in URL for navigation (will be cleaned up by the target page)
            window.location.href = `${path}?token=${token}`;
        }

        // Form submission handler
        document.getElementById('challengeFormElement').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const formData = new FormData(this);
            const challengeData = {
                name: formData.get('name'),
                description: formData.get('description'),
                flag: formData.get('flag'),
                points: parseInt(formData.get('points')),
                hint: formData.get('hint') || ''
            };

            const endpoint = isEditing ? `/api/challenges/${formData.get('id')}` : '/api/challenges';
            await adminUtils.submitForm(endpoint, challengeData, isEditing, 'Challenge');
        });

        // YAML upload form submission handler
        document.getElementById('uploadFormElement').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const formData = new FormData(this);
            const submitBtn = this.querySelector('button[type="submit"]');
            const originalText = submitBtn.textContent;
            
            try {
                submitBtn.disabled = true;
                submitBtn.textContent = 'Uploading...';
                
                const token = localStorage.getItem('organizerToken');
                const response = await fetch('/api/challenges/upload', {
                    method: 'POST',
                    headers: {
                        'Authorization': `Bearer ${token}`
                    },
                    body: formData
                });

                const result = await response.json();
                
                if (response.ok) {
                    showResult('success', 'Upload Successful', result.message, true);
                    hideUploadForm();
                } else {
                    showResult('error', 'Upload Failed', result.error || 'Failed to upload challenges');
                }
            } catch (error) {
                console.error('Error uploading YAML:', error);
                showResult('error', 'Error', 'Connection error while uploading file');
            } finally {
                submitBtn.disabled = false;
                submitBtn.textContent = originalText;
            }
        });
    </script>
</body>
</html>