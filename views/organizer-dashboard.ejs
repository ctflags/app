<!DOCTYPE html>
<html>
<head>
    <title>CTF Organizer Dashboard</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <style>
        body { font-family: Arial, sans-serif; margin: 20px; background: #1a1a1a; color: #fff; }
        .container { max-width: 1200px; margin: 0 auto; }
        .header { text-align: center; margin-bottom: 30px; }
        .stats { display: flex; justify-content: space-around; margin: 20px 0; }
        .stat-box { background: #2d2d2d; padding: 20px; border-radius: 8px; text-align: center; }
        .stat-number { font-size: 2em; color: #00ff00; font-weight: bold; }
        .leaderboard { background: #2d2d2d; border-radius: 8px; margin: 20px 0; }
        .leaderboard-container { display: flex; }
        .fixed-columns { flex-shrink: 0; }
        .scrollable-columns { flex-grow: 1; overflow-x: auto; }
        
        .fixed-table, .scrollable-table { border-collapse: collapse; table-layout: fixed; }
        .fixed-table { width: 530px; }
        .scrollable-table { width: 100%; min-width: max-content; }
        
        .leaderboard th, .leaderboard td { 
            padding: 12px; 
            text-align: left; 
            border-bottom: 1px solid #444; 
            white-space: nowrap; 
            vertical-align: top;
            box-sizing: border-box;
        }
        .leaderboard th { background: #333; color: #00ff00; }
        .leaderboard tr:hover td { background: #333; }
        
        .solved { color: #00ff00; font-weight: bold; }
        .solved-with-hint { color: #ff8c00; font-weight: bold; }
        .attempted-with-hint { color: #ff8c00; }
        .unsolved { color: #666; }
        .refresh-btn { background: #00ff00; color: #000; padding: 10px 20px; border: none; border-radius: 4px; cursor: pointer; font-weight: bold; margin: 10px 0; }
        .challenge-header { 
            writing-mode: vertical-rl; 
            text-orientation: mixed; 
            min-width: 40px; 
            height: 180px;
            overflow: hidden;
            padding: 25px;
        }
        
        /* Fixed columns styling */
        .fixed-columns th:nth-child(1), .fixed-columns td:nth-child(1) { width: 60px; }
        .fixed-columns th:nth-child(2), .fixed-columns td:nth-child(2) { width: 160px; }
        .fixed-columns th:nth-child(3), .fixed-columns td:nth-child(3) { width: 80px; }
        .fixed-columns th:nth-child(4), .fixed-columns td:nth-child(4) { width: 80px; }
        .fixed-columns th:nth-child(5), .fixed-columns td:nth-child(5) { width: 150px; border-right: 2px solid #444; }
        
        /* Scrollable columns styling */
        .scrollable-columns th, .scrollable-columns td { 
            min-width: 40px; 
            text-align: left;
            vertical-align: middle;
            padding-left: 25px;
        }
        .scrollable-columns th { 
            vertical-align: bottom; 
        }
        
        /* Ensure both tables have synchronized rows */
        .fixed-table tbody tr, .scrollable-table tbody tr { height: 62px; }
        .fixed-table thead tr, .scrollable-table thead tr { height: 180px; }
        .fixed-table th, .fixed-table td { height: inherit; }
        .scrollable-table th, .scrollable-table td { height: inherit; }
        
        /* Sort button styling */
        .sort-btn {
            background: #555;
            color: #fff;
            border: none;
            padding: 8px 16px;
            margin: 0 5px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 14px;
            transition: all 0.2s;
        }
        .sort-btn:hover {
            background: #666;
        }
        .sort-btn.active {
            background: #ff6b35;
            color: #fff;
        }
        .logo-bottom-center {
            position: fixed;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 100;
        }
        .logo-bottom-center img {
            max-width: 140px;
            height: auto;
            opacity: 0.7;
        }
    </style>
</head>
<body>
    <div class="logo-bottom-center">
        <img src="/images/logo.png" alt="Exoscale">
    </div>
    
    <div class="container">
        <div class="header">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                <h1 style="margin: 0;">🏆 CTF Organizer Dashboard</h1>
                <div>
                    <button class="refresh-btn" onclick="logout()" style="background: #ff4444;">🚪 Logout</button>
                </div>
            </div>
            <!--
            <div style="text-align: center; color: #888; margin-bottom: 20px;">
                Welcome, <%= organizer.name %>
            </div>
            -->
            <div style="text-align: center; margin-bottom: 20px;">
                <button onclick="navigateToPage('/organizer/challenges')" class="refresh-btn" style="margin: 0 10px;">🎯 Manage Challenges</button>
                <button onclick="navigateToPage('/organizer/participants')" class="refresh-btn" style="margin: 0 10px;">👥 Manage Participants</button>
                <button onclick="navigateToPage('/organizer/submissions')" class="refresh-btn" style="margin: 0 10px;">📝 Manage Submissions</button>
                <button onclick="navigateToPage('/organizer/hints')" class="refresh-btn" style="margin: 0 10px;">💡 Manage Hint Views</button>
            </div>
        </div>

        <div class="stats">
            <div class="stat-box">
                <div class="stat-number"><%= participants.length %></div>
                <div>Participants</div>
            </div>
            <div class="stat-box">
                <div class="stat-number"><%= challenges.length %></div>
                <div>Challenges</div>
            </div>
            <div class="stat-box">
                <div class="stat-number"><%= participants.reduce((sum, p) => sum + (parseInt(p.solved_challenges) || 0), 0) %></div>
                <div>Total Solves</div>
            </div>
        </div>

        <!-- Sorting Controls -->
        <div style="background: #2d2d2d; border-radius: 8px; padding: 15px; margin: 20px 0; display: flex; justify-content: space-between; align-items: center;">
            <div>
                <strong>Sort by:</strong>
                <button id="sortByPoints" class="sort-btn" onclick="sortTable('points')">🏆 Points</button>
                <button id="sortByName" class="sort-btn active" onclick="sortTable('name')">📝 Name</button>
            </div>
            <div>
                <button class="refresh-btn" onclick="refreshDashboard()" style="background: #00aa00;">🔄 Refresh Data</button>
            </div>
        </div>

        <!-- Legend -->
        <div style="background: #2d2d2d; border-radius: 8px; padding: 15px; margin: 20px 0; text-align: center;">
            <strong>Legend:</strong>
            <span style="margin: 0 15px;"><span class="solved">✓</span> Solved without hint</span>
            <span style="margin: 0 15px;"><span class="solved-with-hint">✓</span> Solved with hint</span>
            <span style="margin: 0 15px;"><span class="attempted-with-hint">✗</span> Viewed hint, not solved</span>
            <span style="margin: 0 15px;"><span class="unsolved">✗</span> Not solved</span>
        </div>

        <div class="leaderboard">
            <div class="leaderboard-container">
                <!-- Fixed columns -->
                <div class="fixed-columns">
                    <table class="fixed-table">
                        <thead>
                            <tr>
                                <th>Rank</th>
                                <th>Participant</th>
                                <th>Points</th>
                                <th>Solved</th>
                                <th>Last Activity</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% participants.forEach(function(participant, index) { %>
                              <tr>
                                <td><%= index + 1 %></td>
                                <td>
                                  <strong><%= participant.name %></strong><br>
                                </td>
                                <td><strong><%= participant.total_points || 0 %></strong></td>
                                <td><%= parseInt(participant.solved_challenges) || 0 %>/<%= challenges.length %></td>
                                <td><%= participant.last_submission ? '' : 'Never' %><% if (participant.last_submission) { %><span class="relative-time" data-timestamp="<%= participant.last_submission %>"></span><% } %></td>
                              </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
                
                <!-- Scrollable columns -->
                <div class="scrollable-columns">
                    <table class="scrollable-table">
                        <thead>
                            <tr>
                                <% challenges.forEach(function(challenge) { %>
                                  <th class="challenge-header"><%= challenge.name %></th>
                                <% }); %>
                            </tr>
                        </thead>
                        <tbody>
                            <% participants.forEach(function(participant, index) { %>
                              <tr>
                                <% challenges.forEach(function(challenge) { 
                                  const progress = progressMatrix[participant.token] && progressMatrix[participant.token][challenge.id];
                                  const solved = progress && progress.solved;
                                  const hintViewed = progress && progress.hint_viewed;
                                  
                                  let cssClass, symbol;
                                  if (solved && !hintViewed) {
                                    cssClass = 'solved';
                                    symbol = '✓';
                                  } else if (solved && hintViewed) {
                                    cssClass = 'solved-with-hint';
                                    symbol = '✓';
                                  } else if (!solved && hintViewed) {
                                    cssClass = 'attempted-with-hint';
                                    symbol = '✗';
                                  } else {
                                    cssClass = 'unsolved';
                                    symbol = '✗';
                                  }
                                %>
                                  <td class="<%= cssClass %>"><%= symbol %></td>
                                <% }); %>
                              </tr>
                            <% }); %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <script>
        function getRelativeTime(timestamp) {
            if (!timestamp) return 'Never';
            
            const now = new Date();
            let past;
            
            // Try different timestamp formats
            if (timestamp.includes('T')) {
                // ISO format (YYYY-MM-DDTHH:mm:ss.sssZ or similar)
                past = new Date(timestamp);
            } else if (timestamp.includes(' ')) {
                // SQLite format (YYYY-MM-DD HH:mm:ss)
                past = new Date(timestamp + 'Z'); // Treat as UTC
            } else {
                // Fallback
                past = new Date(timestamp);
            }
            
            // Check if date parsing was successful
            if (isNaN(past.getTime())) {
                console.error('Invalid timestamp:', timestamp);
                return 'Invalid date';
            }
            
            const diffInSeconds = Math.floor((now - past) / 1000);
            
            // Handle negative differences (future dates)
            if (diffInSeconds < 0) {
                return 'Just now';
            }
            
            if (diffInSeconds < 60) {
                return diffInSeconds === 1 ? '1 sec' : diffInSeconds + ' secs';
            } else if (diffInSeconds < 3600) {
                const minutes = Math.floor(diffInSeconds / 60);
                return minutes === 1 ? '1 min' : minutes + ' mins';
            } else if (diffInSeconds < 86400) {
                const hours = Math.floor(diffInSeconds / 3600);
                return hours === 1 ? '1 hr' : hours + ' hrs';
            } else if (diffInSeconds < 2592000) {
                const days = Math.floor(diffInSeconds / 86400);
                return days === 1 ? '1 day' : days + ' days';
            } else {
                const months = Math.floor(diffInSeconds / 2592000);
                return months === 1 ? '1 month' : months + ' months';
            }
        }
        
        function updateRelativeTimes() {
            document.querySelectorAll('.relative-time').forEach(function(element) {
                const timestamp = element.getAttribute('data-timestamp');
                element.textContent = getRelativeTime(timestamp);
            });
        }
        
        function logout() {
            localStorage.removeItem('organizerToken');
            localStorage.removeItem('organizerData');
            window.location.href = '/organizer';
        }
        
        function navigateToPage(path) {
            const token = localStorage.getItem('organizerToken');
            if (!token) {
                window.location.href = '/organizer';
                return;
            }
            // Include token in URL for navigation (will be cleaned up by the target page)
            window.location.href = `${path}?token=${token}`;
        }
        
        async function refreshDashboard() {
            const refreshBtn = document.querySelector('button[onclick="refreshDashboard()"]');
            const originalText = refreshBtn.innerHTML;
            
            try {
                // Update button to show loading state
                refreshBtn.innerHTML = '⏳ Refreshing...';
                refreshBtn.disabled = true;
                
                const token = localStorage.getItem('organizerToken');
                if (!token) {
                    window.location.href = '/organizer';
                    return;
                }
                
                // Fetch fresh dashboard data
                const response = await fetch('/api/organizer/dashboard', {
                    headers: {
                        'Authorization': `Bearer ${token}`,
                        'Content-Type': 'application/json'
                    }
                });
                
                if (response.ok) {
                    const data = await response.json();
                    updateDashboardData(data);
                } else {
                    console.error('Failed to refresh dashboard');
                    alert('Failed to refresh dashboard. Please try again.');
                }
            } catch (error) {
                console.error('Error refreshing dashboard:', error);
                alert('Network error. Please try again.');
            } finally {
                // Restore button state
                refreshBtn.innerHTML = originalText;
                refreshBtn.disabled = false;
            }
        }
        
        function updateDashboardData(data) {
            // Update statistics
            const statBoxes = document.querySelectorAll('.stat-number');
            if (statBoxes[0]) statBoxes[0].textContent = data.participants.length;
            if (statBoxes[1]) statBoxes[1].textContent = data.challenges.length;
            if (statBoxes[2]) statBoxes[2].textContent = data.participants.reduce((sum, p) => sum + (parseInt(p.solved_challenges) || 0), 0);
            
            // Update participant table
            updateParticipantTable(data.participants, data.challenges, data.progressMatrix);
            
            // Update relative times
            updateRelativeTimes();
        }
        
        function updateParticipantTable(participants, challenges, progressMatrix) {
            const fixedTbody = document.querySelector('.fixed-table tbody');
            const scrollableTbody = document.querySelector('.scrollable-table tbody');
            
            // Clear existing rows
            fixedTbody.innerHTML = '';
            scrollableTbody.innerHTML = '';
            
            participants.forEach(function(participant, index) {
                // Create fixed columns row
                const fixedRow = document.createElement('tr');
                fixedRow.innerHTML = `
                    <td>${index + 1}</td>
                    <td><strong>${participant.name}</strong><br></td>
                    <td><strong>${participant.total_points || 0}</strong></td>
                    <td>${parseInt(participant.solved_challenges) || 0}/${challenges.length}</td>
                    <td>${participant.last_submission ? '<span class="relative-time" data-timestamp="' + participant.last_submission + '"></span>' : 'Never'}</td>
                `;
                fixedTbody.appendChild(fixedRow);
                
                // Create scrollable columns row
                const scrollableRow = document.createElement('tr');
                challenges.forEach(function(challenge) {
                    const progress = progressMatrix[participant.token] && progressMatrix[participant.token][challenge.id];
                    const solved = progress && progress.solved;
                    const hintViewed = progress && progress.hint_viewed;
                    
                    let cssClass, symbol;
                    if (solved && !hintViewed) {
                        cssClass = 'solved';
                        symbol = '✓';
                    } else if (solved && hintViewed) {
                        cssClass = 'solved-with-hint';
                        symbol = '✓';
                    } else if (!solved && hintViewed) {
                        cssClass = 'attempted-with-hint';
                        symbol = '✗';
                    } else {
                        cssClass = 'unsolved';
                        symbol = '✗';
                    }
                    
                    const cell = document.createElement('td');
                    cell.className = cssClass;
                    cell.textContent = symbol;
                    scrollableRow.appendChild(cell);
                });
                scrollableTbody.appendChild(scrollableRow);
            });
        }
        
        // Sort table function
        function sortTable(sortBy) {
            const fixedTbody = document.querySelector('.fixed-table tbody');
            const scrollableTbody = document.querySelector('.scrollable-table tbody');
            
            const fixedRows = Array.from(fixedTbody.querySelectorAll('tr'));
            const scrollableRows = Array.from(scrollableTbody.querySelectorAll('tr'));
            
            // Get participant data for sorting
            const participantData = fixedRows.map((row, index) => {
                const nameCell = row.querySelector('td:nth-child(2)');
                const pointsCell = row.querySelector('td:nth-child(3)');
                return {
                    name: nameCell.textContent.trim(),
                    points: parseInt(pointsCell.textContent.trim()) || 0,
                    fixedRow: fixedRows[index],
                    scrollableRow: scrollableRows[index],
                    originalIndex: index
                };
            });
            
            // Sort the data
            if (sortBy === 'points') {
                participantData.sort((a, b) => b.points - a.points || a.name.localeCompare(b.name));
            } else { // sort by name
                participantData.sort((a, b) => a.name.localeCompare(b.name));
            }
            
            // Update button states
            document.querySelectorAll('.sort-btn').forEach(btn => btn.classList.remove('active'));
            document.getElementById('sortBy' + (sortBy === 'points' ? 'Points' : 'Name')).classList.add('active');
            
            // Clear and rebuild tables
            fixedTbody.innerHTML = '';
            scrollableTbody.innerHTML = '';
            
            participantData.forEach((participant, newIndex) => {
                // Update rank in fixed row
                const rankCell = participant.fixedRow.querySelector('td:first-child');
                rankCell.textContent = newIndex + 1;
                
                // Append to tables
                fixedTbody.appendChild(participant.fixedRow);
                scrollableTbody.appendChild(participant.scrollableRow);
            });
        }
        
        // Clean up URL if it contains token parameter (from login redirect or refresh)
        if (window.location.search.includes('token=')) {
            const url = new URL(window.location);
            url.search = '';
            window.history.replaceState({}, document.title, url.toString());
        }
        
        // Update times on page load
        updateRelativeTimes();
        
        // Sort by name by default
        sortTable('name');
        
        // Update times every 30 seconds
        setInterval(updateRelativeTimes, 30000);
    </script>
</body>
</html>