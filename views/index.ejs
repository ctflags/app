<!DOCTYPE html>
<html>
<head>
    <title>CTF Platform</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="/css/admin-shared.css">
    <style>
        body { 
            font-family: Arial, sans-serif; 
            background: #1a1a1a; 
            color: #fff; 
            margin: 0; 
            padding: 50px; 
        }
        .container { 
            max-width: 500px; 
            margin: 0 auto; 
            text-align: center; 
        }
        .welcome-box { 
            background: #2d2d2d; 
            padding: 40px; 
            border-radius: 12px; 
            border-left: 4px solid #00ff00;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
        }
        .platform-title { 
            color: #00ff00; 
            margin-bottom: 10px; 
            font-size: 2.5em;
            font-weight: bold;
        }
        .welcome-text { 
            color: #ccc; 
            margin-bottom: 30px; 
            font-size: 1.1em;
            line-height: 1.5;
        }
        .login-form { 
            display: flex;
            flex-direction: column;
            gap: 15px;
            margin-top: 30px;
        }
        .token-input {
            width: 100%;
            padding: 15px;
            background: #333;
            border: 2px solid #555;
            color: #fff;
            border-radius: 6px;
            font-size: 16px;
            transition: border-color 0.2s;
            box-sizing: border-box;
        }
        .token-input:focus {
            outline: none;
            border-color: #00ff00;
            box-shadow: 0 0 10px rgba(0, 255, 0, 0.2);
        }
        .access-btn { 
            display: block;
            text-decoration: none; 
            padding: 15px 30px; 
            border-radius: 6px; 
            font-weight: bold; 
            font-size: 16px;
            transition: all 0.2s ease;
            border: 2px solid transparent;
        }
        .participant-btn { 
            background: #00ff00; 
            color: #000; 
        }
        .participant-btn:hover { 
            background: #00cc00; 
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(0, 255, 0, 0.3);
        }
        .subtitle {
            color: #888;
            font-size: 0.9em;
            margin-top: 5px;
        }
        .btn-group {
            display: flex;
            align-items: center;
            gap: 15px;
        }
        .btn-icon {
            font-size: 1.2em;
            margin-right: 8px;
        }
        
        @media (max-width: 600px) {
            .welcome-box {
                margin: 20px;
                padding: 30px 20px;
            }
            .platform-title {
                font-size: 2em;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="welcome-box">
            <h1 class="platform-title">🚩 CTF Platform</h1>
            <p class="welcome-text">
                Welcome to the Capture The Flag platform!<br>
                Enter your participant token to get started.
            </p>
            
            <form method="GET" action="/p" class="login-form">
                <input type="password" name="token" class="token-input" placeholder="Enter your participant token" required>
                <button type="submit" class="access-btn participant-btn">
                    <span class="btn-icon">🎯</span>
                    Access Challenges
                </button>
            </form>
        </div>
    </div>
    
    <!-- Powered by Exoscale -->
    <div class="powered-by">
        <span class="powered-by-text">Powered by</span>
        <img src="/images/logo.png" alt="Exoscale">
    </div>
</body>
</html>