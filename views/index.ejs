<!DOCTYPE html>
<html>
<head>
    <title>CTF Platform</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <style>
        body { 
            font-family: Arial, sans-serif; 
            background: #1a1a1a; 
            color: #fff; 
            margin: 0; 
            padding: 50px; 
        }
        .container { 
            max-width: 500px; 
            margin: 0 auto; 
            text-align: center; 
        }
        .welcome-box { 
            background: #2d2d2d; 
            padding: 40px; 
            border-radius: 12px; 
            border-left: 4px solid #00ff00;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
        }
        .platform-title { 
            color: #00ff00; 
            margin-bottom: 10px; 
            font-size: 2.5em;
            font-weight: bold;
        }
        .welcome-text { 
            color: #ccc; 
            margin-bottom: 30px; 
            font-size: 1.1em;
            line-height: 1.5;
        }
        .access-buttons { 
            display: flex;
            flex-direction: column;
            gap: 15px;
            margin-top: 30px;
        }
        .access-btn { 
            display: block;
            text-decoration: none; 
            padding: 15px 30px; 
            border-radius: 6px; 
            font-weight: bold; 
            font-size: 16px;
            transition: all 0.2s ease;
            border: 2px solid transparent;
        }
        .participant-btn { 
            background: #00ff00; 
            color: #000; 
        }
        .participant-btn:hover { 
            background: #00cc00; 
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(0, 255, 0, 0.3);
        }
        .organizer-btn { 
            background: #ff6b35; 
            color: #fff; 
        }
        .organizer-btn:hover { 
            background: #e55a2b; 
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(255, 107, 53, 0.3);
        }
        .subtitle {
            color: #888;
            font-size: 0.9em;
            margin-top: 5px;
        }
        .btn-group {
            display: flex;
            align-items: center;
            gap: 15px;
        }
        .btn-icon {
            font-size: 1.2em;
            margin-right: 8px;
        }
        
        @media (max-width: 600px) {
            .welcome-box {
                margin: 20px;
                padding: 30px 20px;
            }
            .platform-title {
                font-size: 2em;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="welcome-box">
            <h1 class="platform-title">🚩 CTF Platform</h1>
            <p class="welcome-text">
                Welcome to the Capture The Flag platform!<br>
                Choose your access level to get started.
            </p>
            
            <div class="access-buttons">
                <a href="/p" class="access-btn participant-btn">
                    <div class="btn-group">
                        <span class="btn-icon">🎯</span>
                        <div>
                            <div>Participant Access</div>
                            <div class="subtitle">Join the competition</div>
                        </div>
                    </div>
                </a>
                
                <a href="/organizer" class="access-btn organizer-btn">
                    <div class="btn-group">
                        <span class="btn-icon">👑</span>
                        <div>
                            <div>Organizer Dashboard</div>
                            <div class="subtitle">Manage the competition</div>
                        </div>
                    </div>
                </a>
            </div>
        </div>
    </div>
</body>
</html>