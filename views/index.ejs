<!DOCTYPE html>
<html>
<head>
    <title>CTF Platform</title>
    <style>
        body { font-family: Arial, sans-serif; background: #1a1a1a; color: #fff; text-align: center; padding: 50px; }
        .container { max-width: 600px; margin: 0 auto; }
        .btn { display: inline-block; background: #00ff00; color: #000; padding: 15px 30px; text-decoration: none; border-radius: 8px; margin: 10px; font-weight: bold; }
        .btn:hover { background: #00cc00; }
        .btn-secondary { background: #ff6b35; }
        .btn-secondary:hover { background: #e55a2b; }
        .buttons { margin: 30px 0; }
    </style>
</head>
<body>
    <div class="container">
        <h1>🚩 CTF Platform</h1>
        <p>Welcome to the Capture The Flag platform!</p>
        
        <div class="buttons">
            <a href="/participant" class="btn">Participant Login</a>
            <a href="/organizer" class="btn btn-secondary">Organizer Dashboard</a>
        </div>
    </div>
</body>
</html>