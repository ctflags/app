<!DOCTYPE html>
<html>
<head>
    <title>CTF Admin Panel</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="/css/admin-shared.css">
    <style>
        body { font-family: Arial, sans-serif; margin: 20px; background: #1a1a1a; color: #fff; }
        .container { max-width: 1200px; margin: 0 auto; }
        .header { text-align: center; margin-bottom: 30px; }
        
        /* Clean dashboard header */
        .dashboard-header {
            background: #2d2d2d;
            border-radius: 12px;
            padding: 30px;
            margin-bottom: 30px;
            border-left: 4px solid #00ff00;
        }
        .header-top {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
        }
        .dashboard-title {
            margin: 0;
            color: #00ff00;
            font-size: 2.2em;
        }
        .nav-buttons {
            display: flex;
            gap: 10px;
        }
        .nav-btn {
            background: #00aa00;
            color: #fff;
            padding: 12px 24px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-weight: bold;
            margin-right: 10px;
            text-decoration: none;
            display: inline-block;
        }
        .nav-btn:hover {
            background: #008800;
        }
        .logout-btn {
            background: #ff4444;
            color: #fff;
            padding: 12px 24px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-weight: bold;
            transition: background 0.2s;
        }
        .logout-btn:hover {
            background: #cc0000;
        }
        
        /* Management actions */
        .management-section {
            margin-bottom: 30px;
        }
        .section-title {
            color: #ccc;
            font-size: 1.1em;
            margin-bottom: 15px;
            font-weight: 500;
        }
        .management-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
        }
        .management-card {
            background: #1a1a1a;
            padding: 20px;
            border-radius: 8px;
            border: 1px solid #444;
            text-align: center;
            cursor: pointer;
            transition: all 0.2s;
            text-decoration: none;
            color: inherit;
        }
        .management-card:hover {
            background: #333;
            border-color: #00ff00;
            transform: translateY(-2px);
        }
        .management-icon {
            font-size: 2em;
            margin-bottom: 10px;
            display: block;
        }
        .management-title {
            font-weight: bold;
            margin-bottom: 5px;
        }
        .management-desc {
            font-size: 0.9em;
            color: #888;
        }
        
        /* Stats section */
        .stats-section {
            margin-bottom: 30px;
        }
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
        }
        .stat-card {
            background: linear-gradient(135deg, #2d2d2d, #1a1a1a);
            padding: 20px;
            border-radius: 8px;
            text-align: center;
            border: 1px solid #444;
        }
        .stat-icon {
            font-size: 1.8em;
            margin-bottom: 8px;
            display: block;
        }
        .stat-number {
            font-size: 2.2em;
            color: #00ff00;
            font-weight: bold;
            margin-bottom: 4px;
        }
        .stat-label {
            color: #ccc;
            font-weight: 500;
            font-size: 0.9em;
        }
        
        /* File section */
        .file-section {
            background: #2d2d2d;
            border-radius: 8px;
            margin: 20px 0;
            padding: 20px;
        }
        .file-upload-area {
            border: 2px dashed #555;
            border-radius: 8px;
            padding: 30px;
            text-align: center;
            background: #1a1a1a;
            margin-bottom: 20px;
            transition: border-color 0.2s;
        }
        .file-upload-area:hover, .file-upload-area.dragover {
            border-color: #00ff00;
        }
        .file-input {
            display: none;
        }
        .upload-btn {
            background: #00ff00;
            color: #000;
            padding: 12px 24px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-weight: bold;
            margin: 10px;
        }
        .upload-btn:hover {
            background: #00cc00;
        }
        .file-list {
            margin-top: 20px;
        }
        .file-item {
            background: #1a1a1a;
            padding: 15px;
            margin: 10px 0;
            border-radius: 6px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .file-info {
            display: flex;
            align-items: center;
            gap: 15px;
        }
        .file-actions {
            display: flex;
            gap: 10px;
        }
        .delete-btn {
            background: #ff4444;
            color: #fff;
            padding: 8px 16px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-weight: bold;
        }
        .delete-btn:hover {
            background: #cc0000;
        }
        
    </style>
</head>
<body>
    <div class="container">
        <!-- Clean Dashboard Header -->
        <div class="dashboard-header">
            <div class="header-top">
                <h1 class="dashboard-title">⚙️ CTF Admin Panel</h1>
                <div class="nav-buttons">
                    <a href="/organizer" class="nav-btn">🏆 Back to Dashboard</a>
                    <button class="logout-btn" onclick="logout()">🚪 Logout</button>
                </div>
            </div>
        </div>

        <!-- Management Actions -->
        <div class="management-section">
            <h3 class="section-title">Management Tools</h3>
            <div class="management-grid">
                <div class="management-card" onclick="navigateToPage('/organizer/challenges')">
                    <span class="management-icon">🎯</span>
                    <div class="management-title">Challenges</div>
                    <div class="management-desc">Create & edit challenges</div>
                </div>
                <div class="management-card" onclick="navigateToPage('/organizer/participants')">
                    <span class="management-icon">👥</span>
                    <div class="management-title">Participants</div>
                    <div class="management-desc">Manage user accounts</div>
                </div>
                <div class="management-card" onclick="navigateToPage('/organizer/submissions')">
                    <span class="management-icon">📝</span>
                    <div class="management-title">Submissions</div>
                    <div class="management-desc">Review flag attempts</div>
                </div>
                <div class="management-card" onclick="navigateToPage('/organizer/hints')">
                    <span class="management-icon">💡</span>
                    <div class="management-title">Hint Views</div>
                    <div class="management-desc">Track hint usage</div>
                </div>
            </div>
        </div>
        
        <!-- Statistics -->
        <div class="stats-section">
            <h3 class="section-title">Competition Statistics</h3>
            <div class="stats-grid">
                <div class="stat-card">
                    <span class="stat-icon">👥</span>
                    <div class="stat-number"><%= participants.length %></div>
                    <div class="stat-label">Participants</div>
                </div>
                <div class="stat-card">
                    <span class="stat-icon">🎯</span>
                    <div class="stat-number"><%= challenges.length %></div>
                    <div class="stat-label">Challenges</div>
                </div>
                <div class="stat-card">
                    <span class="stat-icon">✅</span>
                    <div class="stat-number"><%= participants.reduce((sum, p) => sum + (parseInt(p.solved_challenges) || 0), 0) %></div>
                    <div class="stat-label">Total Solves</div>
                </div>
            </div>
        </div>
        
        <!-- File Sharing Section -->
        <div class="management-section">
            <h3 class="section-title">Shared Files</h3>
            <div class="file-section">
                <p style="color: #ccc; margin-bottom: 20px;">Upload files that participants will need for the CTF challenges (e.g., configuration files, tools, etc.)</p>
                
                <div class="file-upload-area" id="fileUploadArea" onclick="document.getElementById('fileInput').click()">
                    <div>
                        <p style="font-size: 18px; margin: 0;">📤 Click to upload or drag files here</p>
                        <p style="color: #888; font-size: 14px; margin: 10px 0 0;">Supported formats: All file types</p>
                    </div>
                    <input type="file" id="fileInput" class="file-input" multiple>
                </div>
                
                <div class="file-list" id="fileList">
                    <!-- Files will be loaded here -->
                </div>
            </div>
        </div>
    </div>

    <script>
        function logout() {
            localStorage.removeItem('organizerToken');
            localStorage.removeItem('organizerData');
            window.location.href = '/organizer';
        }
        
        function navigateToPage(path) {
            const token = localStorage.getItem('organizerToken');
            if (!token) {
                window.location.href = '/organizer';
                return;
            }
            window.location.href = `${path}?token=${token}`;
        }

        // File upload functionality
        document.getElementById('fileInput').addEventListener('change', handleFileUpload);
        
        // Drag and drop functionality
        const uploadArea = document.getElementById('fileUploadArea');
        
        uploadArea.addEventListener('dragover', (e) => {
            e.preventDefault();
            uploadArea.classList.add('dragover');
        });
        
        uploadArea.addEventListener('dragleave', (e) => {
            e.preventDefault();
            uploadArea.classList.remove('dragover');
        });
        
        uploadArea.addEventListener('drop', (e) => {
            e.preventDefault();
            uploadArea.classList.remove('dragover');
            const files = e.dataTransfer.files;
            uploadFiles(files);
        });

        async function handleFileUpload(event) {
            const files = event.target.files;
            if (files.length > 0) {
                await uploadFiles(files);
                event.target.value = ''; // Reset input
            }
        }

        async function uploadFiles(files) {
            const token = localStorage.getItem('organizerToken');
            if (!token) {
                alert('No organizer token found. Please log in again.');
                window.location.href = '/organizer';
                return;
            }

            for (const file of files) {
                const formData = new FormData();
                formData.append('file', file);
                
                try {
                    const response = await fetch('/api/organizer/upload-file', {
                        method: 'POST',
                        headers: {
                            'Authorization': `Bearer ${token}`
                        },
                        body: formData
                    });
                    
                    if (response.ok) {
                        console.log(`File ${file.name} uploaded successfully`);
                    } else {
                        const errorText = await response.text();
                        alert(`Failed to upload ${file.name}: ${response.status} ${errorText}`);
                    }
                } catch (error) {
                    alert(`Error uploading ${file.name}: ${error.message}`);
                }
            }
            
            loadFileList();
        }

        async function loadFileList() {
            const token = localStorage.getItem('organizerToken');
            if (!token) return;

            try {
                const response = await fetch('/api/organizer/files', {
                    headers: {
                        'Authorization': `Bearer ${token}`
                    }
                });
                
                if (response.ok) {
                    const files = await response.json();
                    displayFileList(files);
                } else {
                    displayFileList([]);
                }
            } catch (error) {
                displayFileList([]);
            }
        }

        function displayFileList(files) {
            const fileList = document.getElementById('fileList');
            
            if (files.length === 0) {
                fileList.innerHTML = '<p style="color: #888; text-align: center;">No files uploaded yet</p>';
                return;
            }
            
            fileList.innerHTML = files.map(file => `
                <div class="file-item">
                    <div class="file-info">
                        <span style="font-size: 18px;">📄</span>
                        <div>
                            <div style="font-weight: bold;">${file.name}</div>
                            <div style="font-size: 12px; color: #888;">
                                ${formatFileSize(file.size)} • Uploaded ${new Date(file.uploadedAt).toLocaleDateString()}
                            </div>
                        </div>
                    </div>
                    <div class="file-actions">
                        <button class="delete-btn" onclick="deleteFile('${file.name}')">🗑️ Delete</button>
                    </div>
                </div>
            `).join('');
        }

        async function deleteFile(filename) {
            if (!confirm(`Are you sure you want to delete "${filename}"?`)) {
                return;
            }

            const token = localStorage.getItem('organizerToken');
            if (!token) return;

            try {
                const response = await fetch(`/api/organizer/files/${encodeURIComponent(filename)}`, {
                    method: 'DELETE',
                    headers: {
                        'Authorization': `Bearer ${token}`
                    }
                });
                
                if (response.ok) {
                    loadFileList();
                } else {
                    alert('Failed to delete file');
                }
            } catch (error) {
                alert('Error deleting file');
            }
        }

        function formatFileSize(bytes) {
            if (bytes === 0) return '0 Bytes';
            const k = 1024;
            const sizes = ['Bytes', 'KB', 'MB', 'GB'];
            const i = Math.floor(Math.log(bytes) / Math.log(k));
            return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
        }

        // Load file list on page load
        loadFileList();

        // Clean up URL if it contains token parameter
        if (window.location.search.includes('token=')) {
            const url = new URL(window.location);
            url.search = '';
            window.history.replaceState({}, document.title, url.toString());
        }
    </script>
</body>
</html>