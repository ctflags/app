<!DOCTYPE html>
<html>
<head>
    <title>CTF - Organizer Login</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <style>
        body { font-family: Arial, sans-serif; background: #1a1a1a; color: #fff; margin: 0; padding: 50px; }
        .container { max-width: 500px; margin: 0 auto; text-align: center; }
        .login-box { background: #2d2d2d; padding: 40px; border-radius: 12px; border-left: 4px solid #ff6b35; box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3); }
        .input-field { width: 100%; padding: 15px; margin: 15px 0; background: #333; border: 2px solid #555; color: #fff; border-radius: 6px; font-size: 16px; box-sizing: border-box; transition: border-color 0.2s; }
        .input-field:focus { outline: none; border-color: #ff6b35; box-shadow: 0 0 10px rgba(255, 107, 53, 0.2); }
        .login-btn { background: #ff6b35; color: #fff; padding: 15px 30px; border: none; border-radius: 6px; cursor: pointer; font-weight: bold; font-size: 16px; width: 100%; transition: all 0.2s ease; border: 2px solid transparent; }
        .login-btn:hover { background: #e55a2b; transform: translateY(-2px); box-shadow: 0 4px 12px rgba(255, 107, 53, 0.3); }
        .error { color: #ff4444; margin: 10px 0; }
        h1 { color: #ff6b35; margin-bottom: 10px; font-size: 2.5em; font-weight: bold; }
        p { color: #ccc; margin-bottom: 30px; font-size: 1.1em; line-height: 1.5; }
    </style>
</head>
<body>
    <div class="container">
        <div class="login-box">
            <h1>🔒 Organizer Access</h1>
            <p>Please enter your organizer token to access the dashboard.</p>
            <form method="GET" action="/organizer">
                <input type="password" name="token" class="input-field" placeholder="Organizer Token" required>
                <button type="submit" class="login-btn">Access Dashboard</button>
            </form>
        </div>
    </div>
</body>
</html>