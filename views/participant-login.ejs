<!DOCTYPE html>
<html>
<head>
    <title>CTF - Participant Login</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <style>
        body { font-family: Arial, sans-serif; background: #1a1a1a; color: #fff; margin: 0; padding: 50px; }
        .container { max-width: 400px; margin: 0 auto; text-align: center; }
        .login-box { background: #2d2d2d; padding: 30px; border-radius: 8px; border-left: 4px solid #00ff00; }
        .input-field { width: 100%; padding: 12px; margin: 15px 0; background: #333; border: 1px solid #555; color: #fff; border-radius: 4px; font-size: 16px; }
        .login-btn { background: #00ff00; color: #000; padding: 12px 30px; border: none; border-radius: 4px; cursor: pointer; font-weight: bold; font-size: 16px; width: 100%; }
        .login-btn:hover { background: #00cc00; }
        .error { color: #ff4444; margin: 10px 0; }
        h1 { color: #00ff00; margin-bottom: 20px; }
        .back-btn { background: #666; color: #fff; padding: 8px 16px; text-decoration: none; border-radius: 4px; display: inline-block; margin-top: 15px; font-size: 14px; }
        .back-btn:hover { background: #777; }
    </style>
</head>
<body>
    <div class="container">
        <div class="login-box">
            <h1>🚩 Participant Access</h1>
            <p>Please enter your participant token to access the challenges.</p>
            <form method="GET" action="/p">
                <input type="text" name="token" class="input-field" placeholder="Participant Token" required>
                <button type="submit" class="login-btn">Access Challenges</button>
            </form>
            <a href="/" class="back-btn">← Back to Home</a>
        </div>
    </div>
</body>
</html>