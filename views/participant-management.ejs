<!DOCTYPE html>
<html>
<%- include('partials/admin-head', { title: 'CTF Participant Management' }) %>
<body>
    <div class="container">
        <div class="header">
            <h1>👥 Participant Management</h1>
            <div class="nav-buttons">
                <button onclick="navigateToPage('/organizer/admin')" class="nav-btn">← Back to Admin Panel</button>
                <button onclick="showCreateForm()" class="nav-btn primary">+ Add New Participant</button>
                <button onclick="showUploadForm()" class="nav-btn secondary">📤 Upload YAML</button>
                <button onclick="deleteAllParticipants()" class="nav-btn danger">🗑️ Delete All</button>
            </div>
        </div>

        <!-- Statistics -->
        <div class="stats">
            <div class="stat-box">
                <div class="stat-number"><%= participants.length %></div>
                <div>Total Participants</div>
            </div>
            <div class="stat-box">
                <div class="stat-number"><%= participants.filter(p => p.total_points > 0).length %></div>
                <div>Active Participants</div>
            </div>
        </div>

        <!-- Create/Edit Form -->
        <div id="participantForm" class="form-container hidden">
            <h3 id="formTitle">Create New Participant</h3>
            <form id="participantFormElement">
                <input type="hidden" id="originalToken" name="originalToken">
                <div class="form-group">
                    <label for="token">Participant Token</label>
                    <input type="text" id="token" name="token" placeholder="CTF-XXXXX" required>
                </div>
                <div class="form-group">
                    <label for="name">Participant Name</label>
                    <input type="text" id="name" name="name" required>
                </div>
                <button type="submit" class="form-btn" id="submitBtn">Create Participant</button>
                <button type="button" class="form-btn cancel" onclick="hideForm()">Cancel</button>
            </form>
        </div>

        <!-- YAML Upload Form -->
        <div id="uploadForm" class="form-container hidden">
            <h3>Upload Participants from YAML</h3>
            <p style="color: #ccc; margin-bottom: 20px;">
                Upload a YAML file with participants in the following format:<br>
                <code style="background: #1a1a1a; padding: 10px; display: block; margin: 10px 0; border-radius: 4px;">
participants:<br>
&nbsp;&nbsp;- token: "p1"<br>
&nbsp;&nbsp;&nbsp;&nbsp;name: "Sample Player01"<br>
&nbsp;&nbsp;- token: "p2"<br>
&nbsp;&nbsp;&nbsp;&nbsp;name: "Sample Player02"
                </code>
            </p>
            <form id="uploadFormElement" enctype="multipart/form-data">
                <div class="form-group">
                    <label for="yamlFile">YAML File</label>
                    <input type="file" id="yamlFile" name="yamlFile" accept=".yaml,.yml,.txt" required>
                </div>
                <button type="submit" class="form-btn">Upload Participants</button>
                <button type="button" class="form-btn cancel" onclick="hideUploadForm()">Cancel</button>
            </form>
        </div>

        <!-- Participants Table -->
        <div class="data-table">
            <table>
                <thead>
                    <tr>
                        <th>Token</th>
                        <th>Name</th>
                        <th>Total Points</th>
                        <th>Challenges Solved</th>
                        <th>Last Activity</th>
                        <th>Created</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% participants.forEach(function(participant) { %>
                      <tr>
                        <td><span class="token"><%= participant.token %></span></td>
                        <td><strong><%= participant.name %></strong></td>
                        <td><%= participant.total_points || 0 %></td>
                        <td><%= participant.solved_challenges || 0 %></td>
                        <td><%= participant.last_submission ? '' : 'Never' %><% if (participant.last_submission) { %><span class="relative-time" data-timestamp="<%= participant.last_submission %>"></span><% } %></td>
                        <td><%= new Date(participant.created_at).toLocaleDateString() %></td>
                        <td>
                            <button class="action-btn edit-btn" onclick="editParticipant('<%= participant.token %>', '<%= participant.name.replace(/'/g, "\\'") %>')">Edit</button>
                            <button class="action-btn delete-btn" onclick="deleteParticipant('<%= participant.token %>', '<%= participant.name.replace(/'/g, "\\'") %>')">Delete</button>
                        </td>
                      </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </div>

    <%- include('partials/popup-confirm') %>
    <%- include('partials/popup-result') %>

    <%- include('partials/admin-scripts') %>
    
    <script>
        // Handle authentication
        <% if (typeof needsAuth !== 'undefined' && needsAuth) { %>
        // Page loaded without token, check localStorage and redirect if needed
        (function() {
            const token = localStorage.getItem('organizerToken');
            if (token) {
                window.location.href = `${window.location.pathname}?token=${token}`;
            } else {
                window.location.href = '/organizer';
            }
        })();
        <% } else { %>
        // Clean up URL if it contains token parameter
        if (window.location.search.includes('token=')) {
            const url = new URL(window.location);
            url.search = '';
            window.history.replaceState({}, document.title, url.toString());
        }
        <% } %>
        
        function navigateToPage(path) {
            const token = localStorage.getItem('organizerToken');
            if (!token) {
                window.location.href = '/organizer';
                return;
            }
            // Include token in URL for navigation (will be cleaned up by the target page)
            window.location.href = `${path}?token=${token}`;
        }
    </script>
    
    <script>
        let isEditing = false;

        function showCreateForm() {
            adminUtils.toggleForm('participantForm', 'formTitle', 'submitBtn', false, 
                'Create New Participant', 'Edit Participant', 'Create Participant', 'Update Participant');
            document.getElementById('participantFormElement').reset();
            document.getElementById('originalToken').value = '';
            document.getElementById('token').disabled = false;
            isEditing = false;
        }

        function editParticipant(token, name) {
            adminUtils.toggleForm('participantForm', 'formTitle', 'submitBtn', true, 
                'Create New Participant', 'Edit Participant', 'Create Participant', 'Update Participant');
            document.getElementById('originalToken').value = token;
            document.getElementById('token').value = token;
            document.getElementById('name').value = name;
            document.getElementById('token').disabled = false; // Allow token changes during edit
            isEditing = true;
        }

        function hideForm() {
            adminUtils.hideForm('participantForm', 'participantFormElement');
            document.getElementById('token').disabled = false;
            isEditing = false;
        }

        function deleteParticipant(token, name) {
            adminUtils.deleteItem('/api/participants', encodeURIComponent(token), name, 'Participant');
        }

        function showUploadForm() {
            document.getElementById('uploadForm').classList.remove('hidden');
            document.getElementById('participantForm').classList.add('hidden');
        }

        function hideUploadForm() {
            document.getElementById('uploadForm').classList.add('hidden');
            document.getElementById('uploadFormElement').reset();
        }

        function deleteAllParticipants() {
            window.popupManager.showConfirmation(
                'Delete All Participants',
                'Are you sure you want to delete ALL participants and their related records (submissions, hint views)?<br><br><strong>This action cannot be undone!</strong>',
                async () => {
                    try {
                        const token = localStorage.getItem('organizerToken');
                        const response = await fetch('/api/participants', {
                            method: 'DELETE',
                            headers: {
                                'Authorization': `Bearer ${token}`,
                                'Content-Type': 'application/json'
                            }
                        });

                        const result = await response.json();
                        
                        if (response.ok) {
                            showResult('success', 'Success', result.message, true);
                        } else {
                            showResult('error', 'Error', result.error || 'Failed to delete participants');
                        }
                    } catch (error) {
                        console.error('Error deleting all participants:', error);
                        showResult('error', 'Error', 'Connection error while deleting participants');
                    }
                }
            );
        }

        // Form submission handler
        document.getElementById('participantFormElement').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const formData = new FormData(this);
            const participantData = {
                token: formData.get('token'),
                name: formData.get('name')
            };

            const endpoint = isEditing ? `/api/participants/${encodeURIComponent(formData.get('originalToken'))}` : '/api/participants';
            await adminUtils.submitForm(endpoint, participantData, isEditing, 'Participant');
        });

        // YAML upload form submission handler
        document.getElementById('uploadFormElement').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const formData = new FormData(this);
            const submitBtn = this.querySelector('button[type="submit"]');
            const originalText = submitBtn.textContent;
            
            try {
                submitBtn.disabled = true;
                submitBtn.textContent = 'Uploading...';
                
                const token = localStorage.getItem('organizerToken');
                const response = await fetch('/api/participants/upload', {
                    method: 'POST',
                    headers: {
                        'Authorization': `Bearer ${token}`
                    },
                    body: formData
                });

                const result = await response.json();
                
                if (response.ok) {
                    showResult('success', 'Upload Successful', result.message, true);
                    hideUploadForm();
                } else {
                    showResult('error', 'Upload Failed', result.error || 'Failed to upload participants');
                }
            } catch (error) {
                console.error('Error uploading YAML:', error);
                showResult('error', 'Error', 'Connection error while uploading file');
            } finally {
                submitBtn.disabled = false;
                submitBtn.textContent = originalText;
            }
        });
    </script>
</body>
</html>