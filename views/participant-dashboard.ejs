<!DOCTYPE html>
<html>
<head>
    <title>CTF - <%= participant.name %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <style>
        body { font-family: Arial, sans-serif; margin: 20px; background: #1a1a1a; color: #fff; }
        .container { max-width: 800px; margin: 0 auto; }
        .header { text-align: center; margin-bottom: 30px; }
        .challenge { background: #2d2d2d; padding: 20px; margin: 15px 0; border-radius: 8px; border-left: 4px solid #00ff00; }
        .challenge.solved { border-left-color: #ff6b35; background: #1a2a1a; }
        .challenge h3 { margin-top: 0; color: #00ff00; }
        .challenge.solved h3 { color: #ff6b35; }
        .flag-input { width: 95%; padding: 10px; margin: 10px 0; background: #333; border: 1px solid #555; color: #fff; border-radius: 4px; }
        .submit-btn { background: #00ff00; color: #000; padding: 10px 20px; border: none; border-radius: 4px; cursor: pointer; font-weight: bold; }
        .submit-btn:hover { background: #00cc00; }
        .submit-btn:disabled { background: #666; cursor: not-allowed; }
        .solved-badge { background: #ff6b35; color: #fff; padding: 5px 10px; border-radius: 20px; font-size: 12px; margin-left: 10px; }
        .solved-badge.hint-used { background: #e67e22; border: 1px solid #d35400; }
        .points { color: #00ff00; font-weight: bold; }
        .hint-penalty { color: #ff6b35; font-size: 12px; margin-left: 5px; font-weight: normal; }
        .challenge-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 10px; }
        .challenge-title { margin: 0; color: #00ff00; }
        .challenge.solved .challenge-title { color: #ff6b35; }
        .hint-link { color: #888; text-decoration: none; font-size: 12px; padding: 4px 8px; border: 1px solid #555; border-radius: 3px; background: #333; transition: all 0.2s; }
        .hint-link:hover { color: #00ff00; border-color: #00ff00; background: #444; }
        .hint-link.viewed { color: #ff8c00; border-color: #ff8c00; background: #2a1a0a; }
        .hint-link.viewed:hover { color: #ffaa33; border-color: #ffaa33; background: #3a2a1a; }
        
        /* Popup styles */
        .popup-overlay { position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.7); z-index: 1000; display: none; align-items: center; justify-content: center; }
        .popup-content { background: #2d2d2d; padding: 20px; border-radius: 8px; max-width: 500px; width: 90%; border: 2px solid #00ff00; position: relative; }
        .popup-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 15px; }
        .popup-title { color: #00ff00; margin: 0; font-size: 18px; }
        .popup-close { background: none; border: none; color: #fff; font-size: 24px; cursor: pointer; padding: 0; width: 30px; height: 30px; display: flex; align-items: center; justify-content: center; }
        .popup-close:hover { color: #ff4444; }
        .popup-body { color: #fff; line-height: 1.5; }
        
        /* Result popup styles */
        .result-popup { background: #2d2d2d; padding: 30px; border-radius: 8px; max-width: 400px; width: 90%; text-align: center; position: relative; }
        .result-popup.success { border-left: 4px solid #00ff00; }
        .result-popup.error { border-left: 4px solid #ff4444; }
        .result-popup h2 { margin: 0 0 15px 0; font-size: 24px; }
        .result-popup.success h2 { color: #00ff00; }
        .result-popup.error h2 { color: #ff4444; }
        .result-popup p { margin: 0 0 20px 0; color: #fff; }
        .result-close-btn { background: #00ff00; color: #000; padding: 10px 20px; border: none; border-radius: 4px; cursor: pointer; font-weight: bold; }
        .result-close-btn:hover { background: #00cc00; }
        .files-section {
            background: #2d2d2d;
            border-radius: 8px;
            margin: 20px 0;
            padding: 20px;
        }
        .file-item {
            background: #1a1a1a;
            padding: 15px;
            margin: 10px 0;
            border-radius: 6px;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .file-info {
            display: flex;
            align-items: center;
            gap: 15px;
        }
        .download-btn {
            background: #00ff00;
            color: #000;
            padding: 8px 16px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            font-weight: bold;
            text-decoration: none;
            display: inline-block;
        }
        .download-btn:hover {
            background: #00cc00;
        }
        .logo-bottom-center {
            position: fixed;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 100;
        }
        .logo-bottom-center img {
            max-width: 140px;
            height: auto;
            opacity: 0.7;
        }
    </style>
</head>
<body>
    <div class="logo-bottom-center">
        <img src="/images/logo.png" alt="Exoscale">
    </div>
    
    <div class="container">
        <div class="header">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
                <div>
                    <h1 style="margin: 0;">🚩 Capture The Flag</h1>
                </div>
                <div>
                    <button onclick="logout()" style="background: #ff4444; color: #fff; padding: 10px 20px; border: none; border-radius: 4px; cursor: pointer; font-weight: bold;">🚪 Logout</button>
                </div>
            </div>
            <div style="text-align: center;">
                <h2>Welcome, <%= participant.name %></h2>
            </div>
        </div>

        <% challenges.forEach(function(challenge) { %>
          <div class="challenge <%= challenge.solved ? 'solved' : '' %>">
            <div class="challenge-header">
              <h3 class="challenge-title">
                <%= challenge.name %> 
                <% if (challenge.solved && challenge.hint_viewed) { %>
                  <span class="points">(<%= challenge.points - 10 %> pts)</span>
                  <span class="hint-penalty">(-10 for hint)</span>
                <% } else { %>
                  <span class="points">(<%= challenge.points %> pts)</span>
                <% } %>
                <% if (challenge.solved) { %>
                  <% if (challenge.hint_viewed) { %>
                    <span class="solved-badge hint-used">SOLVED (with hint)</span>
                  <% } else { %>
                    <span class="solved-badge">SOLVED</span>
                  <% } %>
                <% } %>
              </h3>
              <% if (challenge.hint && challenge.hint.trim() && !challenge.solved) { %>
                <a href="#" class="hint-link <%= challenge.hint_viewed ? 'viewed' : '' %>" onclick="showHint(<%= challenge.id %>, '<%= challenge.name.replace(/'/g, "\\'") %>', '<%= challenge.hint.replace(/'/g, "\\'").replace(/\n/g, "\\n") %>'); return false;">💡 Hint <%= challenge.hint_viewed ? '(viewed)' : '' %></a>
              <% } %>
            </div>
            <p><%= challenge.description %></p>
            <% if (!challenge.solved) { %>
              <form onsubmit="submitFlag(event, <%= challenge.id %>, '<%= token %>')">
                <input type="text" class="flag-input" placeholder="Enter flag here..." required>
                <button type="submit" class="submit-btn">Submit Flag</button>
              </form>
            <% } else { %>
              <p style="color: #ff6b35;">✓ Challenge completed!</p>
            <% } %>
          </div>
        <% }); %>

        <!-- Files Section -->
        <div class="files-section">
            <h3 style="color: #00ff00; margin-top: 0;">📁 Shared Files</h3>
            <p style="color: #ccc; margin-bottom: 20px;">Download files shared by the organizers for the CTF challenges</p>
            
            <div id="participantFileList">
                <!-- Files will be loaded here -->
            </div>
        </div>
    </div>

    <!-- Hint Popup -->
    <div id="hintPopup" class="popup-overlay">
        <div class="popup-content">
            <div class="popup-header">
                <h4 class="popup-title" id="hintTitle">Challenge Hint</h4>
                <button class="popup-close" onclick="hideHint()">&times;</button>
            </div>
            <div class="popup-body" id="hintBody">
                <!-- Hint content will be inserted here -->
            </div>
        </div>
    </div>

    <!-- Result Popup -->
    <div id="resultPopup" class="popup-overlay">
        <div class="result-popup" id="resultBox">
            <h2 id="resultTitle">Result</h2>
            <p id="resultMessage">Message</p>
            <button class="result-close-btn" onclick="hideResult()">Continue</button>
        </div>
    </div>

    <script>
        async function submitFlag(event, challengeId, token) {
            event.preventDefault();
            const form = event.target;
            const flagInput = form.querySelector('.flag-input');
            const submitBtn = form.querySelector('.submit-btn');
            
            submitBtn.disabled = true;
            submitBtn.textContent = 'Submitting...';
            
            try {
                const response = await fetch('/api/submit', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        token: token,
                        challengeId: challengeId,
                        flag: flagInput.value
                    })
                });
                
                const result = await response.json();
                
                if (result.correct) {
                    showResult('success', '🎉 Correct!', 'Well done! You solved this challenge!', true);
                } else {
                    showResult('error', '❌ Incorrect Flag', 'That\'s not the right flag. Try again!', false);
                    flagInput.value = '';
                }
            } catch (error) {
                showResult('error', '⚠️ Connection Error', 'Error submitting flag. Please check your connection and try again.', false);
            }
            
            submitBtn.disabled = false;
            submitBtn.textContent = 'Submit Flag';
        }

        function logout() {
            window.location.href = '/p';
        }

        async function showHint(challengeId, challengeName, hint) {
            // Record hint view
            try {
                await fetch('/api/hint-viewed', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        token: '<%= token %>',
                        challengeId: challengeId
                    })
                });
                
                // Update the hint link UI immediately to show it as viewed
                updateHintLinkAsViewed(challengeId);
                
            } catch (error) {
                console.error('Error recording hint view:', error);
                // Continue showing hint even if recording fails
            }
            
            // Show hint popup
            document.getElementById('hintTitle').textContent = `💡 ${challengeName} - Hint`;
            document.getElementById('hintBody').innerHTML = hint.replace(/\n/g, '<br>');
            document.getElementById('hintPopup').style.display = 'flex';
        }

        function updateHintLinkAsViewed(challengeId) {
            // Find the hint link for this challenge and mark it as viewed
            const hintLinks = document.querySelectorAll('.hint-link');
            hintLinks.forEach(link => {
                // Check if this link is for the current challenge by examining the onclick attribute
                const onclickAttr = link.getAttribute('onclick');
                if (onclickAttr && onclickAttr.includes(`showHint(${challengeId},`)) {
                    // Add the viewed class
                    link.classList.add('viewed');
                    
                    // Update the text to include "(viewed)" if it doesn't already
                    if (!link.textContent.includes('(viewed)')) {
                        link.textContent = link.textContent + ' (viewed)';
                    }
                }
            });
        }

        function hideHint() {
            document.getElementById('hintPopup').style.display = 'none';
        }

        function showResult(type, title, message, shouldReload) {
            const resultBox = document.getElementById('resultBox');
            const resultTitle = document.getElementById('resultTitle');
            const resultMessage = document.getElementById('resultMessage');
            
            // Set content
            resultTitle.textContent = title;
            resultMessage.textContent = message;
            
            // Set styling based on type
            resultBox.className = `result-popup ${type}`;
            
            // Store reload preference
            document.getElementById('resultPopup').setAttribute('data-reload', shouldReload);
            
            // Show popup
            document.getElementById('resultPopup').style.display = 'flex';
        }

        function hideResult() {
            const shouldReload = document.getElementById('resultPopup').getAttribute('data-reload') === 'true';
            document.getElementById('resultPopup').style.display = 'none';
            
            if (shouldReload) {
                location.reload();
            }
        }

        // Close popup when clicking outside
        document.getElementById('hintPopup').addEventListener('click', function(e) {
            if (e.target === this) {
                hideHint();
            }
        });

        document.getElementById('resultPopup').addEventListener('click', function(e) {
            if (e.target === this) {
                hideResult();
            }
        });

        // Close popup with Escape key
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                if (document.getElementById('hintPopup').style.display === 'flex') {
                    hideHint();
                } else if (document.getElementById('resultPopup').style.display === 'flex') {
                    hideResult();
                }
            }
        });

        // Load shared files for participants
        async function loadParticipantFiles() {
            try {
                const response = await fetch('/api/participant/files');
                
                if (response.ok) {
                    const files = await response.json();
                    displayParticipantFiles(files);
                } else {
                    console.error('Failed to load files');
                }
            } catch (error) {
                console.error('Error loading files:', error);
            }
        }

        function displayParticipantFiles(files) {
            const fileList = document.getElementById('participantFileList');
            
            if (files.length === 0) {
                fileList.innerHTML = '<p style="color: #888; text-align: center;">No files available yet</p>';
                return;
            }
            
            fileList.innerHTML = files.map(file => `
                <div class="file-item">
                    <div class="file-info">
                        <span style="font-size: 18px;">📄</span>
                        <div>
                            <div style="font-weight: bold;">${file.name}</div>
                            <div style="font-size: 12px; color: #888;">
                                ${formatFileSize(file.size)} • Available for download
                            </div>
                        </div>
                    </div>
                    <div>
                        <a href="${file.downloadUrl}" class="download-btn" download>⬇️ Download</a>
                    </div>
                </div>
            `).join('');
        }

        function formatFileSize(bytes) {
            if (bytes === 0) return '0 Bytes';
            const k = 1024;
            const sizes = ['Bytes', 'KB', 'MB', 'GB'];
            const i = Math.floor(Math.log(bytes) / Math.log(k));
            return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
        }

        // Load files on page load
        loadParticipantFiles();
    </script>
</body>
</html>