<!DOCTYPE html>
<html>
<%- include('partials/admin-head', { title: 'CTF Submission Management' }) %>
<body>
    <div class="container">
        <div class="header">
            <h1>📝 Submission Management</h1>
            <div class="nav-buttons">
                <button onclick="navigateToPage('/organizer/admin')" class="nav-btn">← Back to Admin Panel</button>
                <button onclick="showCreateForm()" class="nav-btn primary">+ Add New Submission</button>
            </div>
        </div>

        <!-- Statistics -->
        <div class="stats">
            <div class="stat-box">
                <div class="stat-number"><%= stats.total_submissions || 0 %></div>
                <div>Total Submissions</div>
            </div>
            <div class="stat-box">
                <div class="stat-number"><%= stats.correct_submissions || 0 %></div>
                <div>Correct Submissions</div>
            </div>
            <div class="stat-box">
                <div class="stat-number"><%= stats.incorrect_submissions || 0 %></div>
                <div>Incorrect Submissions</div>
            </div>
            <div class="stat-box">
                <div class="stat-number"><%= Math.round(((stats.correct_submissions || 0) / (stats.total_submissions || 1)) * 100) %></div>
                <div>Success Rate (%)</div>
            </div>
        </div>

        <!-- Filters -->
        <div class="filters">
            <div class="filter-group">
                <label>Participant:</label>
                <select id="participantFilter" onchange="filterTable()">
                    <option value="">All Participants</option>
                    <% participants.forEach(function(participant) { %>
                        <option value="<%= participant.token %>"><%= participant.name %></option>
                    <% }); %>
                </select>
            </div>
            <div class="filter-group">
                <label>Challenge:</label>
                <select id="challengeFilter" onchange="filterTable()">
                    <option value="">All Challenges</option>
                    <% challenges.forEach(function(challenge) { %>
                        <option value="<%= challenge.id %>"><%= challenge.name %></option>
                    <% }); %>
                </select>
            </div>
            <div class="filter-group">
                <label>Status:</label>
                <select id="statusFilter" onchange="filterTable()">
                    <option value="">All Status</option>
                    <option value="true">Correct</option>
                    <option value="false">Incorrect</option>
                </select>
            </div>
            <div class="filter-group">
                <button class="form-btn" onclick="clearFilters()">Clear Filters</button>
            </div>
        </div>

        <!-- Create/Edit Form -->
        <div id="submissionForm" class="form-container hidden">
            <h3 id="formTitle">Create New Submission</h3>
            <form id="submissionFormElement">
                <input type="hidden" id="submissionId" name="id">
                <div class="form-group">
                    <label for="participantToken">Participant</label>
                    <select id="participantToken" name="participantToken" required>
                        <option value="">Select Participant</option>
                        <% participants.forEach(function(participant) { %>
                            <option value="<%= participant.token %>"><%= participant.name %> (<%= participant.token %>)</option>
                        <% }); %>
                    </select>
                </div>
                <div class="form-group">
                    <label for="challengeId">Challenge</label>
                    <select id="challengeId" name="challengeId" required>
                        <option value="">Select Challenge</option>
                        <% challenges.forEach(function(challenge) { %>
                            <option value="<%= challenge.id %>"><%= challenge.name %></option>
                        <% }); %>
                    </select>
                </div>
                <div class="form-group">
                    <label for="submittedFlag">Submitted Flag</label>
                    <input type="text" id="submittedFlag" name="submittedFlag" required>
                </div>
                <div class="form-group">
                    <label for="isCorrect">Status</label>
                    <select id="isCorrect" name="isCorrect" required>
                        <option value="">Select Status</option>
                        <option value="1">Correct</option>
                        <option value="0">Incorrect</option>
                    </select>
                </div>
                <button type="submit" class="form-btn" id="submitBtn">Create Submission</button>
                <button type="button" class="form-btn cancel" onclick="hideForm()">Cancel</button>
            </form>
        </div>

        <!-- Submissions Table -->
        <div class="data-table">
            <table id="submissionsTable">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Participant</th>
                        <th>Challenge</th>
                        <th>Submitted Flag</th>
                        <th>Status</th>
                        <th>Submitted At</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% submissions.forEach(function(submission) { %>
                      <tr data-participant="<%= submission.participant_token %>" data-challenge="<%= submission.challenge_id %>" data-status="<%= submission.is_correct %>">
                        <td><%= submission.id %></td>
                        <td><span class="participant-name"><%= submission.participant_name %></span></td>
                        <td><span class="challenge-name"><%= submission.challenge_name %></span></td>
                        <td><span class="flag"><%= submission.submitted_flag %></span></td>
                        <td><span class="<%= submission.is_correct ? 'correct' : 'incorrect' %>"><%= submission.is_correct ? 'Correct' : 'Incorrect' %></span></td>
                        <td><%= new Date(submission.submitted_at).toLocaleString() %></td>
                        <td>
                            <button class="action-btn edit-btn" onclick="editSubmission(<%= submission.id %>, '<%= submission.participant_token %>', <%= submission.challenge_id %>, '<%= submission.submitted_flag.replace(/'/g, "\\'") %>', <%= submission.is_correct %>)">Edit</button>
                            <button class="action-btn delete-btn" onclick="deleteSubmission(<%= submission.id %>, '<%= submission.participant_name.replace(/'/g, "\\'") %>', '<%= submission.challenge_name.replace(/'/g, "\\'") %>')">Delete</button>
                        </td>
                      </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </div>

    <%- include('partials/popup-result') %>

    <%- include('partials/admin-scripts') %>
    
    <script>
        // Handle authentication
        <% if (typeof needsAuth !== 'undefined' && needsAuth) { %>
        // Page loaded without token, check localStorage and redirect if needed
        (function() {
            const token = localStorage.getItem('organizerToken');
            if (token) {
                window.location.href = `${window.location.pathname}?token=${token}`;
            } else {
                window.location.href = '/organizer';
            }
        })();
        <% } else { %>
        // Clean up URL if it contains token parameter
        if (window.location.search.includes('token=')) {
            const url = new URL(window.location);
            url.search = '';
            window.history.replaceState({}, document.title, url.toString());
        }
        <% } %>
        
        function navigateToPage(path) {
            const token = localStorage.getItem('organizerToken');
            if (!token) {
                window.location.href = '/organizer';
                return;
            }
            // Include token in URL for navigation (will be cleaned up by the target page)
            window.location.href = `${path}?token=${token}`;
        }
    </script>
    
    <script>
        let isEditing = false;

        function showCreateForm() {
            adminUtils.toggleForm('submissionForm', 'formTitle', 'submitBtn', false, 
                'Create New Submission', 'Edit Submission', 'Create Submission', 'Update Submission');
            document.getElementById('submissionFormElement').reset();
            document.getElementById('submissionId').value = '';
            isEditing = false;
        }

        function editSubmission(id, participantToken, challengeId, submittedFlag, isCorrect) {
            adminUtils.toggleForm('submissionForm', 'formTitle', 'submitBtn', true, 
                'Create New Submission', 'Edit Submission', 'Create Submission', 'Update Submission');
            document.getElementById('submissionId').value = id;
            document.getElementById('participantToken').value = participantToken;
            document.getElementById('challengeId').value = challengeId;
            document.getElementById('submittedFlag').value = submittedFlag;
            document.getElementById('isCorrect').value = isCorrect ? '1' : '0';
            isEditing = true;
        }

        function hideForm() {
            adminUtils.hideForm('submissionForm', 'submissionFormElement');
            isEditing = false;
        }

        async function deleteSubmission(id, participantName, challengeName) {
            try {
                const response = await adminUtils.makeRequest(`/api/submissions/${id}`, {
                    method: 'DELETE'
                });
                
                if (response.ok) {
                    showResult('success', '✅ Submission Deleted', `Submission from "${participantName}" for "${challengeName}" has been deleted successfully.`, true);
                } else {
                    const error = await response.json();
                    showResult('error', '❌ Deletion Failed', 'Error deleting submission: ' + error.message);
                }
            } catch (error) {
                showResult('error', '❌ Network Error', 'Error deleting submission: ' + error.message);
            }
        }

        function filterTable() {
            const participantFilter = document.getElementById('participantFilter').value;
            const challengeFilter = document.getElementById('challengeFilter').value;
            const statusFilter = document.getElementById('statusFilter').value;
            
            adminUtils.filterTable('#submissionsTable', {
                participant: participantFilter,
                challenge: challengeFilter,
                status: statusFilter
            });
        }

        function clearFilters() {
            adminUtils.clearFilters(['participantFilter', 'challengeFilter', 'statusFilter']);
            filterTable();
        }

        // Form submission handler
        document.getElementById('submissionFormElement').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const formData = new FormData(this);
            const submissionData = {
                participantToken: formData.get('participantToken'),
                challengeId: parseInt(formData.get('challengeId')),
                submittedFlag: formData.get('submittedFlag'),
                isCorrect: formData.get('isCorrect') === '1'
            };

            const endpoint = isEditing ? `/api/submissions/${formData.get('id')}` : '/api/submissions';
            await adminUtils.submitForm(endpoint, submissionData, isEditing, 'Submission');
        });
    </script>
</body>
</html>